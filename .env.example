# Small Business Sales Manager - Environment Variables Configuration
# Backend (Spring Boot 3.3.4 + Java 21)

# Server Port (Render sets this dynamically via $PORT)
PORT=8080

# Database Configuration (PostgreSQL)
# For local development with PostgreSQL:
DATABASE_URL=jdbc:postgresql://localhost:5432/small_business_sales
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password
# Note: If DATABASE_URL is not set, the application automatically falls back to embedded H2 database (zero setup needed)

# Security & Authentication
JWT_SECRET=your_secure_256_bit_random_secret_key_for_hmac_sha256_thinqloud_crm

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# AI Sales Assistant (Google Gemini)
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-1.5-flash

# Frontend Configuration (.env)
# VITE_API_URL=http://localhost:8080/api
