# ==============================================================================
# RENDER BACKEND ENVIRONMENT CONFIGURATION
# Copy these variables into your Render Dashboard under:
# Service -> Environment -> Environment Variables
# ==============================================================================

# Java Runtime
JAVA_VERSION=21

# Server Port (Render dynamically injects this, default 8080)
PORT=8080

# Database Connection (Render Managed PostgreSQL)
# When linked via Blueprint (render.yaml), DATABASE_URL is automatically populated.
# For manual setup, copy the "Internal Database URL" from your Render PostgreSQL instance:
DATABASE_URL=postgres://sales_user:your_secure_password@dpg-xxxxxxxxxxxx-a.singapore-postgres.render.com/sales_manager

# Optional explicit DB credentials (if not using full DATABASE_URL):
# DATABASE_USERNAME=sales_user
# DATABASE_PASSWORD=your_secure_password

# JWT Authentication Secret (Must be a secure 256-bit+ random string)
JWT_SECRET=c21hbGwtYnVzaW5lc3Mtc2FsZXMtY3JtLXByb2R1Y3Rpb24tc2VjdXJlLWp3dC1rZXktMjAyNi0yNTZiaXQ=

# CORS Frontend URL (Set to your deployed Vercel domain)
FRONTEND_URL=https://small-biz-sales-manager.vercel.app

# Google Gemini AI Integration (Optional - built-in fallback active if omitted)
AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
